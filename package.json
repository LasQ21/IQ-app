{
  "name": "cc146-wittio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "typecheck": "tsc -b",
    "deck": "node scripts/deck-live-slide.mjs docs/deck/CC-146-Wittio-deck.source.html docs/deck/CC-146-Wittio-deck.html --notes docs/deck/speaker-notes.json && cp docs/deck/CC-146-Wittio-deck.html public/deck.html"
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "@vercel/blob": "2.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
